{
    "name": "publicala/laravel-ragno",
    "description": "Laravel database driver for the Ragno SQL-over-HTTP protocol: read-only queries routed through an HTTP gateway, with Eloquent and the query builder untouched.",
    "keywords": [
        "laravel",
        "database",
        "driver",
        "read-only",
        "sql-over-http",
        "ragno",
        "eloquent",
        "gateway"
    ],
    "homepage": "https://github.com/publicala/laravel-ragno",
    "license": "MIT",
    "authors": [
        {
            "name": "publica.la",
            "homepage": "https://publica.la"
        }
    ],
    "require": {
        "php": "^8.4",
        "composer-runtime-api": "^2.0",
        "ext-json": "*",
        "illuminate/console": "^12.0|^13.0",
        "illuminate/contracts": "^12.0|^13.0",
        "illuminate/database": "^12.0|^13.0",
        "illuminate/http": "^12.0|^13.0",
        "illuminate/support": "^12.0|^13.0"
    },
    "require-dev": {
        "driftingly/rector-laravel": "^2.3",
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "pestphp/pest": "^4.0",
        "pestphp/pest-plugin-type-coverage": "^4.0",
        "rector/rector": "^2.4"
    },
    "autoload": {
        "psr-4": {
            "Publicala\\Ragno\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Publicala\\Ragno\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Publicala\\Ragno\\RagnoServiceProvider"
            ],
            "aliases": {
                "Ragno": "Publicala\\Ragno\\Facades\\Ragno"
            }
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "scripts": {
        "lint": [
            "vendor/bin/rector process",
            "vendor/bin/pint"
        ],
        "test:lint": [
            "vendor/bin/pint --test",
            "vendor/bin/rector process --dry-run"
        ],
        "test:types": "vendor/bin/phpstan analyse --memory-limit=512M",
        "test:type-coverage": "@php -d memory_limit=1G vendor/bin/pest --type-coverage --min=100",
        "test:unit": "vendor/bin/pest",
        "test:coverage": "vendor/bin/pest --coverage --min=100",
        "test": [
            "@test:type-coverage",
            "@test:types",
            "@test:lint",
            "@test:coverage"
        ]
    },
    "scripts-descriptions": {
        "lint": "Apply Rector + Pint fixes",
        "test:lint": "Check formatting (Pint) and transforms (Rector) without writing",
        "test:types": "PHPStan (level 8, Larastan)",
        "test:type-coverage": "Pest type coverage, must be 100%",
        "test:unit": "Run the Pest suite",
        "test:coverage": "Run the Pest suite with 100% code coverage required (needs a coverage driver: `herd coverage composer test:coverage`)",
        "test": "Full gate: type coverage, static analysis, lint, and 100% code coverage"
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
